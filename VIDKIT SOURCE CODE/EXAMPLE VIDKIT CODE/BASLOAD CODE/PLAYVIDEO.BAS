#INCLUDE "STANDARD.DEF"

LOCK.KEYS = $33
KEEP.OPEN = $466
NO.RESTORE = $43A
PAL.RESET = $464
NO.SCREENCHANGE = $467

CLS
PRINT 
PRINT "    VIDKIT DEMO VIDEO PLAYER !"
PRINT
PRINT " LOADING VIDKIT !"
GOSUB LOADVIDKIT
PRINT " VIDKIT LOADED !"
PRINT

POKE PAL.RESET, 0

STARTOVER:
 PLAYED = 0
STARTVIDS:
POKE NO.RESTORE, 1
PRINT
PRINT CHR$($05);" ENTER ";CHR$($99);" EXIT ";CHR$($05);" TO END."
PRINT " ENTER THE NAME OF AN SPV FILE (NO EXTENSION)-> ";CHR$($9E);
IF PLAYED THEN GOSUB FADE.IN.DEFPAL
LINPUT VIDNAME$
PRINT CHR$(5)

IF VIDNAME$="EXIT" THEN PRINT:PRINT:PRINT "DONE !":END

F$ = VIDNAME$ + ".SPV":GOSUB FILEEXISTS

IF NOT FE% THEN PRINT:PRINT F$;" NOT FOUND !";CHR$(7):PRINT:GOTO STARTOVER

PRINT " ";F$;" FOUND !"
SLEEP 70
GOSUB LOADVIDEONAME
GOSUB PREPVIDEO
GOSUB FADE2BLACK
GOSUB PLAYPREPPED.MEDIA
PLAYED = -1
GOSUB FADE2BLACK
POKE NO.RESTORE, 0
GOSUB RESTORE.THE.SCREEN
GOTO STARTVIDS


END


LOADVIDKIT:
 REM LOAD AND INITIALIZE THE VIDKIT LIBRARY
 VBA = 5
 VBB = 6
 VBC = 7
 BLOAD "VIDKIT-A000.BIN",8,VBA,$A000
 BANK VBA
  REM INIT THE VIDKIT LIBRARY
  REM REQUIRED
 SYS $A000
RETURN


DEFAULTPALETTE:
REM SET THE DEFAULT VERA PALETTE
 BANK VBB
 SYS $A02A
RETURN

PLAYVIDEO:
REM LOAD & PLAY THE MEDIA FILE NAMED AT
REM 0:BF00
  BANK VBA
  SYS $A003
RETURN

PREPVIDEO:
REM PREPTHEVIDEO NAMED AT 0:BF00
REM FOR PLAY
REM MUST CALL BEFORE ANY SEEK PROCEDURES. 
 BANK VBA
 SYS $A006
RETURN

PLAYPREPPED.MEDIA:
 BANK VBA
 SYS $A009
RETURN

SETFRAMERANGE:
REM PASSING A 32 BIT LONG VALUE
REM FOR THE FRAME TO END VIDEO PLAY ON
REM ONLY 24 SIGNIFICANT BITS (UNSIGNED)
REM PASSED AT R3 
REM CALLED AFTER PREPVIDEO & BEFORE PLAYPREPPED

HWORD = INT(ENDFRAME/65536)
LWORD = ENDFRAME - HWORD
  POKE R3L, FN LO.BYTE(LWORD)
  POKE R3H, FN HI.BYTE(LWORD)
  POKE R4L, FN LO.BYTE(HWORD)
  POKE R4H, 0

REM PASSING A 32 BIT LONG VALUE
REM FOR THE FRAME TO END VIDEO PLAY ON
REM ONLY 24 SIGNIFICANT BITS (UNSIGNED)
REM PASSED AT R0 
REM CALLED AFTER PREPVIDEO & BEFORE PLAYPREPPED
SETSTARTFRAME:
  HWORD = INT(STARTFRAME/65536)
  LWORD = STARTFRAME - HWORD
  POKE R0L, FN LO.BYTE(LWORD)
  POKE R0H, FN HI.BYTE(LWORD)
  POKE R1L, FN LO.BYTE(HWORD)
  POKE R1H, 0
  BANK VBA
  SYS $A012
RETURN

SETSTARTTIME:
   POKE R5L, FN.LOBYTE(THETIME)
   POKE R5H, FN.HIBYTE(THETIME)
   BANK VBA
   SYS $A015
RETURN

SETSTARTTIME.JIFFIES:
   HWORD = INT(THETIME/65536)
   LWORD = INT(THETIME - (HWORD*65536))
   POKE R4L, FN LO.BYTE(LWORD)
   POKE R4H, FN HI.BYTE(LWORD)
   POKE R5L, FN LO.BYTE(HWORD)
   POKE R5H, 0
   BANK VBA
   SYS $A036
RETURN

REM PUT THE FILENAME WITHOUT THE SPV
REM EXTENSION AT 0:BF00
LOADVIDEONAME:
   BANK 0
   ADDR = $BF00
   FOR I = 1 TO LEN(VIDNAME$)
       POKE ADDR, ASC(MID$(VIDNAME$,I,1))
       ADDR = ADDR + 1
   NEXT
   POKE ADDR, 0:REM NUL TERMINATE THE STRING
RETURN

PLAYTOTIMER:
   HWORD = INT(TIMERTARGET/65536)
   LWORD = TIMERTARGET - HWORD
   POKE R4L, FN LO.BYTE(LWORD)
   POKE R4H, FN HI.BYTE(LWORD)
   POKE R5L, FN LO.BYTE(HWORD)
   POKE R5H, FN HI.BYTE(HWORD)
   BANK VBA
   SYS $A033
RETURN

RESTORE.THE.SCREEN:
  GOSUB HIDEALLSPRITES
  BANK VBB
  SYS $AA15
RETURN

FADE.IN.DEFPAL:
  BANK VBC
  SYS $B415
RETURN
 

FADE2BLACK:
  BANK VBB
  SYS $A039
RETURN

HIDEALLSPRITES:
   BANK VBB
   SYS $A024
RETURN

#INCLUDE "STANDARD.BI"

