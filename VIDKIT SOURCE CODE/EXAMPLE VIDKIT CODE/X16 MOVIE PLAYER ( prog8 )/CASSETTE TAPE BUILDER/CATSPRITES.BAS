GOSUB SETREGVARS
SCREEN $80
RECT 0,0,319,239,0

OPEN 6,8,6, "@:TAPESPRITES.BIN,S,W"

FOR Z = 1 TO 26
    GOSUB CATSPRITES
NEXT Z

CLOSE 6

END

    


CATSPRITES:

PUTIMAGE = 0
NAMEIDX = Z
RESTORE SDATA

FOR J = 1 TO 2
     READ PRE$, X1, Y1
     X2 = X1+31
     Y2 = Y1+31
     ADDN$ = STR$(NAMEIDX)
     ADDN$ = RIGHT$(ADDN$,LEN(ADDN$)-1)
     F$ = PRE$+ "-SPRITE" + ADDN$ + ".SPR"
     CLS
     PRINT "CATTING ";F$
     OPEN 4,8,4, F$+",S,R"
     FOR I = 1 TO 1024
         GET# 4, X$
         B = ASC(X$)
         PRINT# 6, CHR$(B);
         PRINT ".";
     NEXT I
     CLOSE 4
NEXT J
RETURN

SDATA:
DATA "L", 92, 74, "R", 196, 74



CLS
LOCATE 25,1 :PRINT " VERIFICATION "
PUTIMAGE = -1
NAMEIDX = 1
BLITWIDTH = 64
BLITLINES = 32
FOR Y1 = 110 TO 174 STEP 32
 FOR X1 = 0 TO 192 STEP 64
     ADDN$ = STR$(NAMEIDX)
     ADDN$ = RIGHT$(ADDN$,LEN(ADDN$)-1)
     F$ = "SPRITE" + ADDN$ + ".IMG"
     PRINT "SHOWING ";F$,
     GOSUB BITBLT
     NUMFILES = NAMEIDX
     NAMEIDX = NAMEIDX + 1
 NEXT X1
NEXT Y1
CLS
PRINT "DONE WITH CREATION"
PRINT "CONCATENATING"

OPEN 4,8,4,"@:FILMREEL.SPRS,S,W"


FOR NAMEIDX = 1 TO NUMFILES
     ADDN$ = STR$(NAMEIDX)
     ADDN$ = RIGHT$(ADDN$,LEN(ADDN$)-1)
     F$ = "SPRITE" + ADDN$ + ".IMG"
     CLS
     COLOR 15
     PRINT F$;
     F$ = F$ + ",S,R"
     OPEN 6,8,6, F$
     DCOL = 5
SAVELOOP:
     GET# 6, X$
     EOF = ST
     I = ASC(X$)
     PRINT# 4, CHR$(I);
     IF DCOL = 5 THEN DCOL = 3
     IF DCOL = 7 THEN DCOL = 4
     IF DCOL = 4 THEN DCOL = 5
     IF DCOL = 3 THEN DCOL = 7
     COLOR DCOL
     IF EOF = 0 THEN PRINT ".";:GOTO SAVELOOP
     CLOSE 6
     PRINT:PRINT
     SLEEP 15
NEXT NAMEIDX

CLOSE 4
COLOR 15


END

## BITBLIT IS CALLED WITH PUTIMAGE = 0 (FALSE) TO GET THE IMAGE
## IMAGE IS BUFFERED TO FILE PASSED IN F$
## SCREEN RECTANGLE TO CAPTURE IS PASSED IN X1, Y1, X2, Y2
##
##
## BITBLIT IS CALLED WITH PUTIMAGE = -1 (TRUE) TO PUT THE IMAGE
## ON THE SCREEN F$ WILL HOLD FILE NAME.
## PUT STARTING AT X1, Y1
##
## BLITWIDTH AND BLITLINES NEED TO BE SET TO THE WIDTH AND HEIGHT
## OF THE IMAGE RESPECTIVELY, NO SUCH INFO IS IN THE FILE.
##
## IF IMMEDIATELY FOLLOWING A BITBLIT GETIMAGE CALL THEN
## BLITWIDTH AND BLITLINES WILL ALREADY BE SET.
## IN THAT INSTANCE ONLY X1, Y1 NEED TO BE CHANGED
##
## X1 AND Y1 CAN BE LEFT UNCHANGED IF THE USE IS SAVING A
## SECTION OF SCREEN TO RESTORE AFTER SOMETHING ELSE IS DRAWN
##
##
## FOR THAT CASE CALL BITBLIT WITH PUTIMAGE = FALSE
## DO YOUR SCREEN STUFF
## SET PUTIMAGE TO TRUE,  CALL BITBLIT AGAIN TO RESTORE ALREADY

BITBLT:
    ADDON$=",P,W"
    PREFIX$="@:"
    IF PUTIMAGE THEN PREFIX$="":ADDON$=",S,R"
    FF$=PREFIX$ + F$ + ADDON$
    IF PUTIMAGE THEN SET.IO=CHKIN:DO.FILEIO=MACPTR:GOTO DOSCREENBLIT
    SET.IO = CHKOUT
    DO.FILEIO = MCIOUT
    IF X2>XLIMIT THEN X2=XLIMIT
    IF Y2>YLIMIT THEN Y2=YLIMIT
    BLITWIDTH = (X2-X1) + 1
    BLITLINES = (Y2-Y1) + 1
DOSCREENBLIT:
    OPEN 2,8,2,FF$
    POKE X.REG, 2
    SYS SET.IO
   IF X1 > 255 THEN BYTESPLIT
   POKE R0L, X1
   POKE R0H, 0
   GOTO POKEY
BYTESPLIT:
  POKE R0L, X1 AND $00FF
  POKE R0H, INT(X1/256)
POKEY:
   POKE R1L, Y1
   POKE R1H, 0
   SYS FB.CURSOR.POSITION
   FOR Y= 1 TO BLITLINES
       I=0
   INLOOP:
       BYTES=BLITWIDTH-I
       IF BYTES>$FF THEN BYTES=$FF
       POKE A.REG, BYTES
       POKE X.REG, $23
       POKE Y.REG, $9F
       POKE C.REG, $01
       SYS DO.FILEIO
       I=I+PEEK(X.REG)
       IF I<BLITWIDTH THEN INLOOP
       SYS FB.CURSOR.NEXTLINE
    NEXT Y
    CLOSE 2
    SYS CLRCHN
RETURN


LOADIMAGE:
  BLOAD F$,8,4,$A000
  POKE R0L, (X1 AND $FF)
  POKE R0H, INT(X1/256)
  POKE R1L, (Y1 AND $FF)
  POKE R1H, INT(Y1/256)
  POKE R2L, 0
  POKE R2H, $A0
  POKE R3L, (BLITWIDTH AND $00FF)
  POKE R3H, INT(BLITWIDTH/256)
  POKE R4L, (BLITHEIGHT AND $00FF)
  POKE R4H, INT(BLITHEIGHT/256)
  BANK 4
  SYS GRAPH.DRAWIMAGE
RETURN


SETREGVARS:
 A.REG = $030C
 X.REG = $030D
 Y.REG = $030E
 C.REG = $030F
 R0 = 2
 R0L = R0
 R0H = R0+1
 R1 = 4
 R1L = R1
 R1H = R1 + 1
 R2 = 6
 R2L = R2
 R2H = R2 + 1
 R3 = 8
 R3L = R3
 R3H = R3 + 1
 R4 = 10
 R4L = R4
 R4H = R4 + 1
 R5 = 12
 R5L = R5
 R5H = R5 + 1
 R6 = 14
 R8 = 16
 R9 = 18
 R10 = 20
 R11 = 22
 R12 = 24
 R13 = 26
 R14 = 28
 R15 = 30
 CHKOUT = $FFC9
 CHKIN = $FFC6
 CLRCHN = $FFCC
 MACPTR = $FF44
 MCIOUT = $FEB1
 FB.CURSOR.NEXTLINE = $FF02
 FB.CURSOR.POSITION = $FEFF
 GRAPH.DRAWIMAGE = $FF38
 XLIMIT = 319
 YLIMIT = 239
RETURN
